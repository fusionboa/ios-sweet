+/*
+ * walleye CPU clock: the performance cluster's Operating State Manager (OSM).
+ *
+ * The Pixel 2 boots with the big cluster on the OSM's 300 MHz safe source: the
+ * OSM is the hardware DCVS unit that owns the cluster PLL and the clock mux,
+ * and nothing has sent it a performance state yet.  Linux brings it up in
+ * drivers/clk/msm/clock-osm.c; this file does the smallest useful subset of
+ * that, with the Pixel 2's own tables.
+ *
+ * There is no software rail write here, on purpose.  A LUT row carries only a
+ * *virtual corner*; the OSM forwards that corner to CPRh, and CPRh is the
+ * hardware voltage controller that commands PM8998 S13 (VDD_APC1) itself from
+ * the chip's fused tables.  Writing S13 over SPMI while CPRh owns it would
+ * fight the closed loop and does not raise the clock either.  Raising the
+ * frequency without a matching corner is how a cluster browns out, so the
+ * corner is part of the same atomic request and CPRh must already be serving
+ * before this driver will ask for anything above the boot level.
+ *
+ * Deliberately absent: any bypass of the droop/limits protection (LMH).  It is
+ * not what is holding the clock at 300 MHz - an unprogrammed OSM is - and
+ * disabling it removes the protection that keeps a fast, low-voltage cluster
+ * from resetting.  If PSTATE_STATUS stays below the request, the log below
+ * says so and that is the thing to investigate.
+ *
+ * XNU has no cpufreq governor to set.  On this SoC "governor = performance"
+ * is exactly this: pin DCVS_PERF_STATE_DESIRED to the top usable level.
+ *
+ * Boot args:
+ *   sweetcpufreq=<MHz>  highest level to request (default 1728, Linux's boot
+ *                       rate).  0 = read-only: report, change nothing.
+ */
+
+#include <IOKit/IOLib.h>
+#include <arm64/proc_reg.h>
+#include <machine/atomic.h>          /* DSB_SY */
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <stdint.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" void sweet_status_set(unsigned slot, const char *text);
+extern "C" uint32_t sweet_cpu_clock_mhz(void);   /* SweetCPU.cpp */
+
+/* Register map: drivers/clk/msm/clock-osm.c, msm8998. */
+#define OSM_PERF_PA             0x179C2000ULL
+#define OSM_ENABLE              0x1004
+#define OSM_INDEX(i)            (0x1150 + 32 * (i))
+#define OSM_FREQ(i)             (0x1154 + 32 * (i))
+#define OSM_VOLT(i)             (0x1158 + 32 * (i))
+#define OSM_OVERRIDE(i)         (0x115C + 32 * (i))
+#define OSM_SPARE(i)            (0x1164 + 32 * (i))
+#define OSM_TABLE_SIZE          40              /* hardware LUT slots */
+#define OSM_PSTATE_STATUS       0x1C00
+#define OSM_PSTATE_DESIRED      0x1F10
+
+#define CPRH_PERF_PA            0x179C4000ULL
+#define CPR_CTL                 0x4             /* bit 0: loop enabled */
+#define CPRH_CTL                0x3AA0          /* bit 0: OSM interface up */
+#define CPRH_STATUS             0x3AA4
+
+/* cpr3-regulator.c register map, read-only diagnostic below. */
+#define CPR_STATUS              0x8
+#define CPR_TIMER_AUTO_CONT     0xC
+#define CPR_STEP_QUOT           0x14
+#define CPR_HW_CLOSED_LOOP      0x3000
+#define CPR_TIMER_MID_CONT      0x3004
+#define CPR_TIMER_UP_DN_CONT    0x3008
+#define CPRH_CORNER_REG(n)      (0x3A00 + 4 * (n))
+#define CPRH_CORNER_BAND        0x3AA8
+#define CPRH_CORNER_COUNT       34
+
+#define QFPROM_PA               0x00784000ULL
+#define PERFCL_EFUSE            (0x00784130 - QFPROM_PA)  /* speed bin: 31:29 */
+#define PERFCL_EFUSE_SHIFT      29
+#define PERFCL_EFUSE_MASK       7
+#define PERF_SPEED_BINS         4
+
+#define OSM_MV_SHIFT            16              /* VOLT_REG: corner | mV */
+#define OSM_MV_MASK             0xFFF
+
+struct sweet_osm_entry {
+	uint32_t hz;
+	uint32_t freq_data;
+	uint32_t override_data;
+	uint32_t spare_data;
+	uint8_t  corner;        /* zero based virtual corner */
+};
+
+struct sweet_osm_lut {
+	const struct sweet_osm_entry *rows;
+	unsigned n;
+	const uint16_t *mv;     /* voltage ceiling per corner, millivolts */
+	unsigned corners;
+};
+
