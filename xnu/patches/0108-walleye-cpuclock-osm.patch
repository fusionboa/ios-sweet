+static const uint16_t sweet_perf_mv_3[31] = {
+	 828,  828,  828,  828,  828,  828,  828,  828,  828,  828,  828,  828,
+	 900,  900,  900,  900,  900,  900,  900,  900,  952,  952,  952, 1136,
+	1136, 1136, 1136, 1136, 1136, 1136, 1136,
