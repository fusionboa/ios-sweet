+static const struct sweet_osm_lut sweet_perf_lut[PERF_SPEED_BINS] = {
+	{ sweet_perf_lut_0, sizeof(sweet_perf_lut_0) / sizeof(sweet_perf_lut_0[0]),
+	  sweet_perf_mv_0, sizeof(sweet_perf_mv_0) / sizeof(sweet_perf_mv_0[0]) },
+	{ sweet_perf_lut_1, sizeof(sweet_perf_lut_1) / sizeof(sweet_perf_lut_1[0]),
+	  sweet_perf_mv_1, sizeof(sweet_perf_mv_1) / sizeof(sweet_perf_mv_1[0]) },
+	{ sweet_perf_lut_2, sizeof(sweet_perf_lut_2) / sizeof(sweet_perf_lut_2[0]),
+	  sweet_perf_mv_2, sizeof(sweet_perf_mv_2) / sizeof(sweet_perf_mv_2[0]) },
+	{ sweet_perf_lut_3, sizeof(sweet_perf_lut_3) / sizeof(sweet_perf_lut_3[0]),
+	  sweet_perf_mv_3, sizeof(sweet_perf_mv_3) / sizeof(sweet_perf_mv_3[0]) },
+};
+
+static inline uint32_t
+sclk_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+/* One QFPROM row is 64 bits wide (two 32-bit words). */
+static uint64_t
+sclk_fuse_row(vm_offset_t fuse, unsigned row)
+{
+	return (uint64_t)sclk_rd(fuse, row * 8) |
+	    ((uint64_t)sclk_rd(fuse, row * 8 + 4) << 32);
+}
+
+static uint32_t
+sclk_fuse_bits(vm_offset_t fuse, unsigned row, unsigned lo, unsigned hi)
+{
+	return (uint32_t)((sclk_fuse_row(fuse, row) >> lo) & ((1ULL << (hi - lo + 1)) - 1));
+}
+
+static inline void
+sclk_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+}
+
+/*
+ * One LUT row as the hardware wants it.  The voltage field is the corner the
+ * OSM hands to CPRh plus the millivolt figure CPRh uses before its loop
+ * settles; both come from the same table the OSM will run, so frequency and
+ * voltage can never be programmed from different speed bins.  The ceiling is
+ * used rather than a computed target: it is the highest voltage fused for that
+ * corner, so the open-loop step cannot under-volt.
+ */
+static void
+sclk_row(const struct sweet_osm_lut *lut, unsigned i, uint32_t *index,
+    uint32_t *freq, uint32_t *volt, uint32_t *override, uint32_t *spare)
+{
+	/*
+	 * Slots past the table's end repeat the last level, the way
+	 * clk_osm_setup_hw_table() does; INDEX_REG always carries the slot
+	 * number, because that is the key the OSM looks the row up by.
+	 */
+	unsigned src = i < lut->n ? i : lut->n - 1;
+
+	*index = i;
+	unsigned corner = lut->rows[src].corner;
+	if (corner >= lut->corners) {
+		corner = lut->corners - 1;
+	}
+	*freq = lut->rows[src].freq_data;
+	*volt = ((uint32_t)corner << OSM_MV_SHIFT) | (lut->mv[corner] & OSM_MV_MASK);
+	*override = lut->rows[src].override_data;
+	*spare = lut->rows[src].spare_data;
+}
+
+/* Returns the number of rows that did not read back as written. */
+static unsigned
+sclk_program(vm_offset_t osm, const struct sweet_osm_lut *lut, unsigned first)
+{
+	unsigned bad = 0;
+
+	for (unsigned i = first; i < OSM_TABLE_SIZE; i++) {
+		uint32_t index, freq, volt, override, spare;
+		sclk_row(lut, i, &index, &freq, &volt, &override, &spare);
+		sclk_wr(osm, OSM_INDEX(i), index);
+		sclk_wr(osm, OSM_FREQ(i), freq);
+		sclk_wr(osm, OSM_VOLT(i), volt);
+		sclk_wr(osm, OSM_OVERRIDE(i), override);
+		sclk_wr(osm, OSM_SPARE(i), spare);
+	}
+	__builtin_arm_dsb(DSB_SY);
+
+	for (unsigned i = first; i < OSM_TABLE_SIZE; i++) {
+		uint32_t index, freq, volt, override, spare;
+		sclk_row(lut, i, &index, &freq, &volt, &override, &spare);
+		if (sclk_rd(osm, OSM_INDEX(i)) != index ||
+		    sclk_rd(osm, OSM_FREQ(i)) != freq ||
+		    sclk_rd(osm, OSM_VOLT(i)) != volt ||
+		    sclk_rd(osm, OSM_OVERRIDE(i)) != override ||
+		    sclk_rd(osm, OSM_SPARE(i)) != spare) {
+			bad++;
+		}
+	}
+	return bad;
+}
+
+/*
+ * Read-only CPRh diagnostic (0109).  The perf cluster's controller has never
+ * been started on this port, so before anything can be programmed it has to be
+ * clear whether the block is merely unclocked, programmed-but-halted, or cold.
+ * The corner table answers that: an empty table means ABL never touched it
+ * (it boots on a little core and never needed the big cluster), and then the
+ * fused quotients below are the inputs the table has to be built from.
+ *
+ * Nothing here writes.  Fuse rows 38/69/70/71 are printed raw as well, so the
+ * decoded fields can be re-derived if a bit range below is wrong.
+ */
+static void
+sclk_cpr_dump(vm_offset_t cprh, vm_offset_t fuse)
+{
+	uint32_t ctl = sclk_rd(cprh, CPR_CTL);
+	uint32_t status = sclk_rd(cprh, CPR_STATUS);
+	uint32_t hctl = sclk_rd(cprh, CPRH_CTL);
+	uint32_t hstat = sclk_rd(cprh, CPRH_STATUS);
+
+	IOLog("SWEET CPR: ctl=%#x (loop_en %u) status=%#x (busy %u) auto=%#x step_quot=%#x\n",
+	    ctl, ctl & 1, status, status & 1,
+	    sclk_rd(cprh, CPR_TIMER_AUTO_CONT), sclk_rd(cprh, CPR_STEP_QUOT));
+	IOLog("SWEET CPR: hw_closed_loop=%#x timer_mid=%#x timer_up_dn=%#x\n",
+	    sclk_rd(cprh, CPR_HW_CLOSED_LOOP), sclk_rd(cprh, CPR_TIMER_MID_CONT),
+	    sclk_rd(cprh, CPR_TIMER_UP_DN_CONT));
+	IOLog("SWEET CPR: CPRH ctl=%#x (osm_en %u) status=%#x corner=%u band=%#x\n",
+	    hctl, hctl & 1, hstat, hstat & 0x3f, sclk_rd(cprh, CPRH_CORNER_BAND));
+
+	unsigned used = 0;
+	for (unsigned i = 0; i < CPRH_CORNER_COUNT; i++) {
+		uint32_t c = sclk_rd(cprh, CPRH_CORNER_REG(i));
+		if (c == 0) {
+			continue;
+		}
+		used++;
+		IOLog("SWEET CPR: corner %2u %#010x init %u floor %u qdelta %u ro %u "
+		    "cl_dis %u temp_dis %u lkv %u\n", i, c, c & 0xff, (c >> 8) & 0xff,
+		    (c >> 16) & 0x1ff, (c >> 25) & 0xf, (c >> 29) & 1, (c >> 30) & 1, (c >> 31) & 1);
+	}
+	IOLog("SWEET CPR: %u of %u corner entries programmed%s\n", used, CPRH_CORNER_COUNT,
+	    used ? "" : " - the controller was never set up");
+
+	/* Perf cluster fuse layout: cprh-kbss-regulator.c, PERFORMANCE_CLUSTER_ID. */
+#define FB(row, lo, hi) sclk_fuse_bits(fuse, (row), (lo), (hi))
+	uint32_t iv[4] = { FB(69, 48, 53), FB(69, 42, 47), FB(69, 36, 41), FB(69, 30, 35) };
+	uint32_t tq[4] = { FB(70, 32, 43), FB(70, 20, 31), FB(70, 8, 19),
+		(FB(69, 60, 63) << 8) | FB(70, 0, 7) };
+	uint32_t qo[4] = { 0, (FB(71, 13, 15) << 4) | FB(71, 21, 24), FB(71, 6, 12),
+		(FB(70, 63, 63) << 6) | FB(71, 0, 5) };
+	uint32_t ro[4] = { FB(69, 26, 29), FB(69, 22, 25), FB(69, 18, 21), FB(69, 14, 17) };
+	IOLog("SWEET CPR: fuses speed_bin %u cpr_rev %u force_highest %u aging_diff %u\n",
+	    FB(38, 29, 31), FB(39, 51, 53), FB(100, 45, 45), FB(71, 25, 32));
+	IOLog("SWEET CPR: fuse corners init_voltage %u %u %u %u (6-bit sign/mag)\n",
+	    iv[0], iv[1], iv[2], iv[3]);
+	IOLog("SWEET CPR: fuse corners target_quot %u %u %u %u\n", tq[0], tq[1], tq[2], tq[3]);
+	IOLog("SWEET CPR: fuse corners quot_offset %u %u %u %u (corner 0 has none)\n",
+	    qo[0], qo[1], qo[2], qo[3]);
+	IOLog("SWEET CPR: fuse corners ro_sel %u %u %u %u\n", ro[0], ro[1], ro[2], ro[3]);
+	IOLog("SWEET CPR: raw rows 38=%#llx 39=%#llx 69=%#llx 70=%#llx 71=%#llx 100=%#llx\n",
+	    (unsigned long long)sclk_fuse_row(fuse, 38), (unsigned long long)sclk_fuse_row(fuse, 39),
+	    (unsigned long long)sclk_fuse_row(fuse, 69), (unsigned long long)sclk_fuse_row(fuse, 70),
+	    (unsigned long long)sclk_fuse_row(fuse, 71), (unsigned long long)sclk_fuse_row(fuse, 100));
+#undef FB
+}
+
+/*
+ * Report the current state, then request the fastest level at or below
+ * sweetcpufreq.  Returns the measured clock afterwards, or 0 if nothing was
+ * requested.
+ */
+extern "C" uint32_t
+sweet_cpuclock_up(void)
+{
+	uint32_t target_mhz = 1728;
+	PE_parse_boot_argn("sweetcpufreq", &target_mhz, sizeof(target_mhz));
+
+	vm_offset_t osm = ml_io_map(OSM_PERF_PA, 0x2000);
+	vm_offset_t cprh = ml_io_map(CPRH_PERF_PA, 0x4000);
+	vm_offset_t fuse = ml_io_map(QFPROM_PA, 0x400);   /* covers 0x130..0x137 */
+	if (!osm || !cprh || !fuse) {
+		IOLog("SWEET CPUCLK: map failed (osm %#lx cprh %#lx fuse %#lx)\n",
+		    (unsigned long)osm, (unsigned long)cprh, (unsigned long)fuse);
+		sweet_status_set(8, "O map");
+		return 0;
+	}
+
+	/* Read-only: what the voltage controller looks like before we touch it. */
+	sclk_cpr_dump(cprh, fuse);
+
+	uint32_t bin = (sclk_rd(fuse, (uint32_t)PERFCL_EFUSE) >> PERFCL_EFUSE_SHIFT) &
+	    PERFCL_EFUSE_MASK;
+	/* An unreadable fuse reads as all ones; do not trust a table then. */
+	bool bin_ok = bin < PERF_SPEED_BINS;
+	if (!bin_ok) {
+		IOLog("SWEET CPUCLK: perf speed bin fuse reads %u (invalid); using bin 0 tables\n", bin);
+		bin = 0;
+	}
+	const struct sweet_osm_lut *lut = &sweet_perf_lut[bin];
+
+	uint32_t enable = sclk_rd(osm, OSM_ENABLE);
+	uint32_t pstate = sclk_rd(osm, OSM_PSTATE_STATUS);
+	uint32_t desired = sclk_rd(osm, OSM_PSTATE_DESIRED);
+	bool osm_on = (enable & 1) != 0;
+	IOLog("SWEET CPUCLK: perf speed bin %u, %u levels / %u corners; OSM enable=%#x "
+	    "pstate=%#x desired=%#x\n", bin, lut->n, lut->corners, enable, pstate, desired);
+
+	uint32_t lut0_index = sclk_rd(osm, OSM_INDEX(0));
+	uint32_t lut0_volt = sclk_rd(osm, OSM_VOLT(0));
+	uint32_t lut_last_freq = sclk_rd(osm, OSM_FREQ(lut->n - 1));
+	IOLog("SWEET CPUCLK: LUT[0] index=%u volt=%#x, LUT[%u] freq=%#x (%s)\n",
+	    lut0_index, lut0_volt, lut->n - 1, lut_last_freq,
+	    lut_last_freq ? "programmed" : "empty");
+
+	uint32_t cpr_ctl = sclk_rd(cprh, CPR_CTL);
+	uint32_t cprh_ctl = sclk_rd(cprh, CPRH_CTL);
+	uint32_t cprh_status = sclk_rd(cprh, CPRH_STATUS);
+	bool cprh_on = (cpr_ctl & 1) && (cprh_ctl & 1);
+	IOLog("SWEET CPUCLK: CPRh cpr_ctl=%#x cprh_ctl=%#x status=%#x (corner %u) -> %s\n",
+	    cpr_ctl, cprh_ctl, cprh_status, cprh_status & 0x3f,
+	    cprh_on ? "serving" : "NOT serving");
+
+	char text[8];
+	snprintf(text, sizeof(text), "O%u C%u", (unsigned)osm_on, (unsigned)cprh_on);
+	sweet_status_set(8, text);
+
+	if (target_mhz == 0) {
+		IOLog("SWEET CPUCLK: sweetcpufreq=0, read-only\n");
+		return 0;
+	}
+
+	/*
+	 * The LUT is only safe to (re)write when nothing is running from it, or
+	 * for rows above the level the hardware is executing right now - never
+	 * under the running state machine's feet.
+	 */
+	unsigned cur = pstate & 0x3f;
+	if (cur >= OSM_TABLE_SIZE) {
+		/* Unreadable or unexpected state: assume the safe source. */
+		IOLog("SWEET CPUCLK: pstate %#x is not a LUT slot; assuming level 0\n", pstate);
+		cur = 0;
+	}
+	unsigned first = osm_on ? cur + 1 : 0;
+	unsigned bad = sclk_program(osm, lut, first);
+	if (bad) {
+		IOLog("SWEET CPUCLK: %u LUT rows did not read back; not enabling the OSM\n", bad);
+		sweet_status_set(8, "O lut");
+		return 0;
+	}
+	IOLog("SWEET CPUCLK: LUT rows %u..%u programmed and read back\n", first, OSM_TABLE_SIZE - 1);
+
+	if (!osm_on) {
+		/* Linux clk_osm_enable(): bit 0, then let the hardware settle. */
+		sclk_wr(osm, OSM_ENABLE, enable | 1);
+		__builtin_arm_dsb(DSB_SY);
+		IOSleep(1);
+		uint32_t now = sclk_rd(osm, OSM_ENABLE);
+		IOLog("SWEET CPUCLK: OSM enable %#x -> %#x\n", enable, now);
+		if (!(now & 1)) {
+			IOLog("SWEET CPUCLK: OSM refused to enable; clock stays at the safe source\n");
+			sweet_status_set(8, "O no");
+			return 0;
+		}
+	}
+
+	/*
+	 * No corner will follow the frequency unless CPRh is driving the rail.
+	 * Leave the cluster where it is and let the log say why.
+	 */
+	if (!cprh_on) {
+		IOLog("SWEET CPUCLK: CPRh is not serving VDD_APC1; not raising the request\n");
+		sweet_status_set(8, "O C0");
+		return 0;
+	}
+
+	unsigned best = 0;
+	uint32_t best_hz = 0;
+	for (unsigned i = 0; i < lut->n; i++) {
+		if (lut->rows[i].hz <= (uint64_t)target_mhz * 1000000ULL &&
+		    lut->rows[i].hz >= best_hz) {
+			best = i;
+			best_hz = lut->rows[i].hz;
+		}
+	}
+	if (best == 0) {
+		IOLog("SWEET CPUCLK: no level at or below %u MHz\n", target_mhz);
+		return 0;
+	}
+	if (best == desired && osm_on) {
+		IOLog("SWEET CPUCLK: already requesting level %u (%u MHz)\n", best, best_hz / 1000000);
+		return 0;
+	}
+
+	IOLog("SWEET CPUCLK: requesting level %u (%u MHz, corner %u, %u mV)\n",
+	    best, best_hz / 1000000, lut->rows[best].corner, lut->mv[lut->rows[best].corner]);
+	sclk_wr(osm, OSM_PSTATE_DESIRED, best);
+	__builtin_arm_dsb(DSB_SY);
+	IOSleep(5);
+
+	uint32_t reached = sclk_rd(osm, OSM_PSTATE_STATUS);
+	uint32_t corner_now = sclk_rd(cprh, CPRH_STATUS) & 0x3f;
+	uint32_t mhz = sweet_cpu_clock_mhz();
+	IOLog("SWEET CPUCLK: pstate=%#x (asked %u) CPRh corner %u -> %u MHz\n",
+	    reached, best, corner_now, mhz);
+	if (mhz == 0) {
+		IOLog("SWEET CPUCLK: clock did not measure; leaving as is\n");
+		return 0;
+	}
+
+	/*
+	 * If the measured clock is still the safe source, say so plainly: either
+	 * the OSM did not take the level, or LMH/droop pulled it back. Do not
+	 * touch that protection from here.
+	 */
+	if (mhz < best_hz / 2000000) {
+		IOLog("SWEET CPUCLK: still below the request (WDOG pc %#x); not hacking around it\n",
+		    sclk_rd(osm, 0x1C74));
+	}
+
+	snprintf(text, sizeof(text), "O%u L%u", 1u, best);
+	sweet_status_set(8, text);
+	return mhz;
+}
