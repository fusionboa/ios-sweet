+/* Clock of each CPU in MHz, measured in initCPU (cycle counter vs system counter). */
+static uint32_t sweet_cpu_mhz[SWEET_SMP_MAX_CPUS];
+
+static uint32_t
+sweet_cpu_measure_mhz(void)
+{
+	uint64_t pmcr = __builtin_arm_rsr64("PMCR_EL0");
+	uint64_t counters = __builtin_arm_rsr64("PMCNTENSET_EL0");
+	/* E: enable; D (bit 3) clear: count every cycle */
+	__builtin_arm_wsr64("PMCR_EL0", (pmcr | 1ULL) & ~(1ULL << 3));
+	__builtin_arm_wsr64("PMCNTENSET_EL0", 1ULL << 31);
+	__builtin_arm_isb(ISB_SY);
+	uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t t0 = __builtin_arm_rsr64("CNTVCT_EL0");
+	uint64_t c0 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	uint64_t t1;
+	do {
+		t1 = __builtin_arm_rsr64("CNTVCT_EL0");
+	} while (t1 - t0 < freq / 200);         /* 5 ms */
+	uint64_t c1 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	if (!(counters & (1ULL << 31))) {
+		__builtin_arm_wsr64("PMCNTENCLR_EL0", 1ULL << 31);
+	}
+	__builtin_arm_wsr64("PMCR_EL0", pmcr);
+	__builtin_arm_isb(ISB_SY);
+	return (uint32_t)((c1 - c0) * freq / (t1 - t0) / 1000000);
+}
 
