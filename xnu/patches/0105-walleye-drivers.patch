+/*
+ * walleye A/B boot slots, so the phone can boot iOS from its boot partition
+ * without a PC. On every boot ABL counts down the retry count in the GPT
+ * entry of boot_<slot> until the OS marks the slot successful, and then falls
+ * back to the other slot (Qualcomm PartitionTableUpdate.h attribute bits:
+ * 48-49 priority, 50 active, 51-53 retry count, 54 successful, 55 unbootable;
+ * Android's bootctrl markBootSuccessful sets bit 54 of boot_<slot>).
+ *
+ * boot-arg sweetslot=0 (default): report the boot_a/boot_b attributes only.
+ * sweetslot=1: once the system has been up sweetslotsecs (default 120), set
+ * bit 54 for the active slot in the PRIMARY GPT. Both CRCs are verified
+ * before and after; the entry array is written before the header, and the
+ * backup GPT is never written, so a bad primary falls back to the untouched
+ * backup. Nothing else on any LUN can be written by this code.
+ */
+#define GPT_ATTR_ACTIVE         (1ULL << 50)
+#define GPT_ATTR_SUCCESSFUL     (1ULL << 54)
+#define GPT_ATTR_UNBOOTABLE     (1ULL << 55)
+#define GPT_MAX_LUN             8u
+
+struct sweet_gpt {
+	uint8_t lun;
+	uint64_t entry_lba;
+	uint32_t nent, esz, hdr_size, entry_blocks;
+	int boot[2];                            /* entry index of boot_a, boot_b */
+	uint64_t attr[2];
+};
+
+static uint8_t sweet_gpt_header[UFS_BLOCK];     /* LBA 1, whole block */
+
+/* Read and verify the primary GPT of lun; entries stay in the bounce buffer. */
+static int
+ufs_gpt_load(uint8_t lun, struct sweet_gpt *g)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint32_t hcrc, ecrc;
+	int error = EIO;
+
+	bzero(g, sizeof(*g));
+	g->lun = lun;
+	g->boot[0] = g->boot[1] = -1;
+	su.lun = lun;
+	for (int i = 0; i < 3 && error; i++) {  /* first command may see a unit attention */
+		error = ufs_read_blocks(1, 1);
+	}
+	if (error) {
+		return error;
+	}
+	memcpy(sweet_gpt_header, b, UFS_BLOCK);
+	memcpy(&g->hdr_size, sweet_gpt_header + 12, 4);
+	memcpy(&hcrc, sweet_gpt_header + 16, 4);
+	memcpy(&g->entry_lba, sweet_gpt_header + 72, 8);
+	memcpy(&g->nent, sweet_gpt_header + 80, 4);
+	memcpy(&g->esz, sweet_gpt_header + 84, 4);
+	memcpy(&ecrc, sweet_gpt_header + 88, 4);
+	if (memcmp(sweet_gpt_header, "EFI PART", 8) != 0 || g->hdr_size < 92 ||
+	    g->hdr_size > 512 || g->esz != 128 || g->nent == 0 ||
+	    g->nent > BOUNCE_SIZE / 128 || g->entry_lba < 2) {
+		return ENXIO;
+	}
+	uint8_t hdr[512];
+	memcpy(hdr, sweet_gpt_header, g->hdr_size);
+	bzero(hdr + 16, 4);
+	if (crc32(0, hdr, g->hdr_size) != hcrc) {
+		printf("SWEET SLOT: LUN %u GPT header CRC mismatch\n", lun);
+		return EINVAL;
+	}
+	g->entry_blocks = (g->nent * g->esz + UFS_BLOCK - 1) / UFS_BLOCK;
+	error = ufs_read_blocks(g->entry_lba, g->entry_blocks);
+	if (error) {
+		return error;
+	}
+	if (crc32(0, b, (size_t)g->nent * g->esz) != ecrc) {
+		printf("SWEET SLOT: LUN %u GPT entries CRC mismatch\n", lun);
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < g->nent; i++) {
+		const uint8_t *e = b + i * g->esz;
+		char name[8];
+		unsigned c;
+		for (c = 0; c < 7; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		int slot = strcmp(name, "boot_a") == 0 ? 0 : strcmp(name, "boot_b") == 0 ? 1 : -1;
+		if (slot >= 0 && e[56 + 2 * 6] == 0 && e[57 + 2 * 6] == 0) {
+			g->boot[slot] = (int)i;
+			memcpy(&g->attr[slot], e + 48, 8);
+		}
+	}
+	return (g->boot[0] >= 0 && g->boot[1] >= 0) ? 0 : ENOENT;
+}
+
+/* Only the verified primary GPT header and entry array of g->lun. */
+static int
+ufs_gpt_write(const struct sweet_gpt *g, uint64_t lba, uint32_t count)
+{
+	if (su.lun != g->lun || !((lba == 1 && count == 1) ||
+	    (lba == g->entry_lba && count == g->entry_blocks))) {
+		printf("SWEET SLOT: refusing write of %u blocks at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0x08,                     /* WRITE(10), FUA */
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+static void
+sweet_slot_report(const struct sweet_gpt *g)
+{
+	for (int s = 0; s < 2; s++) {
+		uint64_t a = g->attr[s];
+		printf("SWEET SLOT: LUN %u boot_%c attr 0x%016llx: priority %llu active %llu "
+		    "retries %llu successful %llu unbootable %llu\n", g->lun, 'a' + s, a,
+		    (a >> 48) & 3, (a >> 50) & 1, (a >> 51) & 7, (a >> 54) & 1, (a >> 55) & 1);
+	}
+}
+
+/* Set bit 54 for the active slot of the verified GPT g (entries in the bounce buffer). */
+static int
+sweet_slot_mark(const struct sweet_gpt *g)
+{
+	int active = -1;
+	for (int s = 0; s < 2; s++) {
+		if ((g->attr[s] & GPT_ATTR_ACTIVE) && !(g->attr[s] & GPT_ATTR_UNBOOTABLE)) {
+			active = active == -1 ? s : -2;
+		}
+	}
+	if (active < 0) {
+		printf("SWEET SLOT: no single active slot; nothing marked\n");
+		return 0;
+	}
+	if (g->attr[active] & GPT_ATTR_SUCCESSFUL) {
+		printf("SWEET SLOT: boot_%c already successful\n", 'a' + active);
+		return 0;
+	}
+	uint8_t *b = (uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t attr = g->attr[active] | GPT_ATTR_SUCCESSFUL;
+	memcpy(b + (uint32_t)g->boot[active] * g->esz + 48, &attr, 8);
+	uint32_t ecrc = crc32(0, b, (size_t)g->nent * g->esz);
+	memcpy(sweet_gpt_header + 88, &ecrc, 4);
+	bzero(sweet_gpt_header + 16, 4);
+	uint32_t hcrc = crc32(0, sweet_gpt_header, g->hdr_size);
+	memcpy(sweet_gpt_header + 16, &hcrc, 4);
+	/* Entries first: a header that does not match them leaves the primary
+	 * invalid and firmware uses the backup GPT. */
+	int error = ufs_gpt_write(g, g->entry_lba, g->entry_blocks);
+	if (!error) {
+		memcpy(b, sweet_gpt_header, UFS_BLOCK);
+		error = ufs_gpt_write(g, 1, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	struct sweet_gpt check;
+	if (!error) {
+		error = ufs_gpt_load(g->lun, &check);
+	}
+	if (!error && !(check.attr[active] & GPT_ATTR_SUCCESSFUL)) {
+		error = EIO;
+	}
+	printf("SWEET SLOT: marking boot_%c successful: %s (%d)\n", 'a' + active,
+	    error ? "FAILED" : "done", error);
+	if (!error) {
+		sweet_slot_report(&check);
+	}
+	return error;
+}
+
+/* Find boot_a/boot_b (all LUNs), optionally mark the active slot successful. */
+static void
+sweet_slot_run(bool mark)
+{
+	struct sweet_gpt g;
+	int error = ENOENT;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint8_t lun = 0; lun < GPT_MAX_LUN && error; lun++) {
+		error = ufs_gpt_load(lun, &g);
+	}
+	if (error) {
+		printf("SWEET SLOT: no LUN with a valid GPT holding boot_a and boot_b\n");
+	} else {
+		sweet_slot_report(&g);
+		if (mark) {
+			(void)sweet_slot_mark(&g);
+		}
+	}
+	su.lun = 0;
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
+
+static uint32_t sweet_slot_mode, sweet_slot_secs = 120;
+static int sweet_slot_chan;
+
+static void
+sweet_slot_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	sweet_slot_run(false);
+	if (sweet_slot_mode == 1) {
+		(void)tsleep(&sweet_slot_chan, PZERO, "sweetslot", hz * (int)sweet_slot_secs);
+		sweet_slot_run(true);
+	}
+}
+
+static void
+sweet_slot_start(void)
+{
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetslot", &sweet_slot_mode, sizeof(sweet_slot_mode));
+	PE_parse_boot_argn("sweetslotsecs", &sweet_slot_secs, sizeof(sweet_slot_secs));
+	if (sweet_slot_secs < 30 || sweet_slot_secs > 3600) {
+		sweet_slot_secs = 120;
+	}
+	if (kernel_thread_start(sweet_slot_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
