+/* Panel pixel -> Q16 position (0..0xffff) on the presented display. */
+extern "C" bool
+sweet_fb_panel_to_unit(int x, int y, int32_t *ux, int32_t *uy,
+    uint32_t *logical_w, uint32_t *logical_h)
+{
+	if (!gSweetFBGeometry.valid) {
+		return false;
+	}
+	int64_t nx, ny;
+	if (gSweetFBGeometry.scaled) {
+		nx = ((int64_t)(x - gSweetFBGeometry.outX) << 16) / gSweetFBGeometry.outW;
+		ny = ((int64_t)(y - gSweetFBGeometry.outY) << 16) / gSweetFBGeometry.outH;
+	} else {
+		nx = ((int64_t)(x + gSweetFBGeometry.offX) << 16) / gSweetFBGeometry.logicalW;
+		ny = ((int64_t)(y + gSweetFBGeometry.offY) << 16) / gSweetFBGeometry.logicalH;
+	}
+	*ux = (int32_t)(nx < 0 ? 0 : (nx > 0xffff ? 0xffff : nx));
+	*uy = (int32_t)(ny < 0 ? 0 : (ny > 0xffff ? 0xffff : ny));
+	*logical_w = gSweetFBGeometry.logicalW;
+	*logical_h = gSweetFBGeometry.logicalH;
+	return true;
+}
