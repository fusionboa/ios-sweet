diff --git a/bsd/dev/sweet_rpm.c b/bsd/dev/sweet_rpm.c
new file mode 100644
index 0000000..327527a
--- /dev/null
+++ b/bsd/dev/sweet_rpm.c
@@ -0,0 +1,518 @@
+/*
+ * walleye: regulator votes to the MSM8998 RPM over GLINK, polled.
+ *
+ * Linux: drivers/rpmsg/qcom_glink_rpm.c (two FIFOs in the RPM message RAM,
+ * found through the TOC in its last 256 bytes; 32-bit accesses only),
+ * qcom_glink_native.c (VERSION, OPEN, TX_DATA; the RPM link is intentless)
+ * and drivers/soc/qcom/smd-rpm.c ("req" packets with key/value pairs).
+ * Live DT: qcom,glink-rpm-native-xprt, msgram 0x778000 + 0x7000, doorbell
+ * 0x17911008 mask 1. The RX interrupt is not used; replies are polled for.
+ * Kernel thread context only, one request at a time.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <IOKit/IOLocks.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_rpm_vreg_enable(const char *type, unsigned id, unsigned uv, unsigned ma);
+
+#define RPM_RAM_PA              0x00778000u
+#define RPM_RAM_SIZE            0x7000u
+#define RPM_IPC_PA              0x17911000u     /* APCS global; +8: IPC, bit 0 = RPM */
+#define RPM_TOC_SIZE            256u
+#define RPM_TOC_MAGIC           0x67727430u     /* "grt0" */
+#define RPM_TX_FIFO_ID          0x61703272u     /* "ap2r" */
+#define RPM_RX_FIFO_ID          0x72326170u     /* "r2ap" */
+
+#define GLINK_VERSION_1         1u
+#define GLINK_CMD_VERSION       0u
+#define GLINK_CMD_VERSION_ACK   1u
+#define GLINK_CMD_OPEN          2u
+#define GLINK_CMD_CLOSE         3u
+#define GLINK_CMD_OPEN_ACK      4u
+#define GLINK_CMD_INTENT        5u
+#define GLINK_CMD_RX_DONE       6u
+#define GLINK_CMD_RX_INTENT_REQ 7u
+#define GLINK_CMD_RX_INTENT_REQ_ACK 8u
+#define GLINK_CMD_TX_DATA       9u
+#define GLINK_CMD_CLOSE_ACK     11u
+#define GLINK_CMD_TX_DATA_CONT  12u
+#define GLINK_CMD_READ_NOTIF    13u
+#define GLINK_CMD_RX_DONE_W_REUSE 14u
+#define GLINK_CMD_SIGNALS       15u
+
+#define RPM_CHANNEL             "rpm_requests"
+#define RPM_LCID                1u
+#define RPM_NO_RCID             0xffffffffu
+#define RPM_SERVICE_REQ         0x00716572u     /* "req" */
+#define RPM_MSG_ID              0x2367736du     /* "msg#" */
+#define RPM_MSG_ERR             0x00727265u     /* "err" */
+#define RPM_KEY_SWEN            0x6e657773u     /* "swen" */
+#define RPM_KEY_UV              0x00007675u     /* "uv" */
+#define RPM_KEY_MA              0x0000616du     /* "ma" */
+#define RPM_SET_ACTIVE          0u
+#define RPM_SET_SLEEP           1u
+
+#define ALIGN8(x)               (((x) + 7u) & ~7u)
+
+struct rpm_pipe {
+	vm_offset_t tail, head, fifo;   /* indices are byte offsets into fifo */
+	uint32_t len;
+};
+
+static struct {
+	vm_offset_t ram, ipc;
+	struct rpm_pipe tx, rx;
+	IOLock *lock;
+	bool mapped, up, broken;
+	bool version_ack, open_ack, remote_open;
+	uint32_t rcid, msg_id;
+	bool replied;
+	uint32_t reply_id;
+	int reply_status;
+} rpm;
+
+static uint32_t
+rpm_rd(vm_offset_t va)
+{
+	uint32_t v = *(volatile uint32_t *)va;
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rpm_wr(vm_offset_t va, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)va = v;
+}
+
+static uint32_t
+rpm_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static bool
+rpm_pipe_ok(const struct rpm_pipe *p)
+{
+	return rpm_rd(p->head) < p->len && rpm_rd(p->tail) < p->len;
+}
+
+static uint32_t
+rpm_rx_avail(void)
+{
+	uint32_t head = rpm_rd(rpm.rx.head), tail = rpm_rd(rpm.rx.tail);
+	return head >= tail ? head - tail : rpm.rx.len - tail + head;
+}
+
+/* count and offset are multiples of 4 (the tail is always 8 aligned). */
+static void
+rpm_rx_peek(void *data, uint32_t offset, uint32_t count)
+{
+	uint32_t pos = rpm_rd(rpm.rx.tail) + offset;
+	uint32_t *out = (uint32_t *)data;
+	while (pos >= rpm.rx.len) {
+		pos -= rpm.rx.len;
+	}
+	for (uint32_t i = 0; i < count / 4; ++i) {
+		out[i] = rpm_rd(rpm.rx.fifo + pos);
+		pos += 4;
+		if (pos >= rpm.rx.len) {
+			pos = 0;
+		}
+	}
+}
+
+static void
+rpm_rx_advance(uint32_t count)
+{
+	uint32_t tail = rpm_rd(rpm.rx.tail) + count;
+	while (tail >= rpm.rx.len) {
+		tail -= rpm.rx.len;
+	}
+	rpm_wr(rpm.rx.tail, tail);
+}
+
+static uint32_t
+rpm_tx_avail(void)
+{
+	uint32_t head = rpm_rd(rpm.tx.head), tail = rpm_rd(rpm.tx.tail);
+	return tail <= head ? rpm.tx.len - head + tail : tail - head;
+}
+
+/* One message: header + data, zero padded to 8 bytes, then the doorbell. */
+static int
+rpm_tx(const void *hdr, uint32_t hlen, const void *data, uint32_t dlen)
+{
+	uint32_t words[32];
+	uint32_t len = ALIGN8(hlen + dlen);
+	if (len > sizeof(words) || (hlen & 3u)) {
+		return EINVAL;
+	}
+	bzero(words, sizeof(words));
+	memcpy(words, hdr, hlen);
+	if (dlen) {
+		memcpy((uint8_t *)words + hlen, data, dlen);
+	}
+	unsigned waited = 0;
+	while (rpm_tx_avail() <= len + 8) {
+		if (++waited > 100) {
+			printf("SWEET RPM: TX FIFO full\n");
+			return EBUSY;
+		}
+		delay(1000);
+	}
+	uint32_t head = rpm_rd(rpm.tx.head);
+	for (uint32_t i = 0; i < len / 4; ++i) {
+		rpm_wr(rpm.tx.fifo + head, words[i]);
+		head += 4;
+		if (head >= rpm.tx.len) {
+			head = 0;
+		}
+	}
+	rpm_wr(rpm.tx.head, head);
+	__asm__ volatile("dsb osh" ::: "memory");
+	rpm_wr(rpm.ipc + 8, 1);
+	__asm__ volatile("dsb osh" ::: "memory");
+	return 0;
+}
+
+static int
+rpm_cmd(uint32_t cmd, uint32_t param1, uint32_t param2)
+{
+	uint32_t msg[2] = {cmd | (param1 << 16), param2};
+	return rpm_tx(msg, sizeof(msg), NULL, 0);
+}
+
+/* A reply on rpm_requests: "req" header, then "msg#" (and "err") entries. */
+static void
+rpm_parse_reply(const uint8_t *p, uint32_t len)
+{
+	if (len < 8 || rpm_le32(p) != RPM_SERVICE_REQ || rpm_le32(p + 4) > len - 8) {
+		return;
+	}
+	const uint8_t *b = p + 8, *end = b + rpm_le32(p + 4);
+	bool have_id = false;
+	uint32_t id = 0;
+	int status = 0;
+	while (end - b >= 8) {
+		uint32_t type = rpm_le32(b), mlen = rpm_le32(b + 4);
+		if (mlen > (uint32_t)(end - b) - 8) {
+			break;
+		}
+		if (type == RPM_MSG_ID && mlen >= 4) {
+			id = rpm_le32(b + 8);
+			have_id = true;
+		} else if (type == RPM_MSG_ERR) {
+			char text[33];
+			uint32_t n = MIN(mlen, (uint32_t)sizeof(text) - 1);
+			memcpy(text, b + 8, n);
+			text[n] = 0;
+			printf("SWEET RPM: error reply \"%s\"\n", text);
+			status = EINVAL;
+		}
+		b += 8 + ((mlen + 3u) & ~3u);
+	}
+	if (have_id) {
+		rpm.reply_id = id;
+		rpm.reply_status = status;
+		rpm.replied = true;
+	}
+}
+
+/* Consume everything the RPM sent. Returns false if the link is unusable. */
+static bool
+rpm_rx_poll(void)
+{
+	for (unsigned guard = 0; guard < 256; ++guard) {
+		if (!rpm_pipe_ok(&rpm.rx)) {
+			return false;
+		}
+		uint32_t avail = rpm_rx_avail();
+		if (avail < 8) {
+			return true;
+		}
+		uint32_t msg[4];
+		rpm_rx_peek(msg, 0, 8);
+		uint32_t cmd = msg[0] & 0xffffu, param1 = msg[0] >> 16, param2 = msg[1];
+		uint32_t need = 8;
+		switch (cmd) {
+		case GLINK_CMD_VERSION:
+			(void)rpm_cmd(GLINK_CMD_VERSION_ACK, GLINK_VERSION_1, 0);
+			break;
+		case GLINK_CMD_VERSION_ACK:
+			rpm.version_ack = true;
+			break;
+		case GLINK_CMD_OPEN: {
+			char name[40];
+			need = 8 + ALIGN8(param2);
+			if (param2 == 0 || param2 > 32) {
+				return false;
+			}
+			if (avail < need) {
+				return true;
+			}
+			bzero(name, sizeof(name));
+			rpm_rx_peek(name, 8, ALIGN8(param2));
+			name[param2 - 1] = 0;
+			if (strcmp(name, RPM_CHANNEL) == 0) {
+				rpm.rcid = param1;
+				rpm.remote_open = true;
+			}
+			printf("SWEET RPM: remote open \"%s\" rcid %u\n", name, param1);
+			(void)rpm_cmd(GLINK_CMD_OPEN_ACK, param1, 0);
+			break;
+		}
+		case GLINK_CMD_OPEN_ACK:
+			if (param1 == RPM_LCID) {
+				rpm.open_ack = true;
+			}
+			break;
+		case GLINK_CMD_CLOSE:
+			if (param1 == rpm.rcid) {
+				rpm.remote_open = false;
+			}
+			(void)rpm_cmd(GLINK_CMD_CLOSE_ACK, param1, 0);
+			break;
+		case GLINK_CMD_TX_DATA:
+		case GLINK_CMD_TX_DATA_CONT: {
+			if (avail < 16) {
+				return true;
+			}
+			rpm_rx_peek(msg, 0, 16);
+			uint32_t chunk = msg[2], left = msg[3];
+			if (chunk > rpm.rx.len - 16) {
+				return false;
+			}
+			need = ALIGN8(16 + chunk);
+			if (avail < need) {
+				return true;
+			}
+			if (rpm.rcid == RPM_NO_RCID) {
+				rpm.rcid = param1;      /* the RPM did not re-send its OPEN */
+			}
+			if (param1 == rpm.rcid && cmd == GLINK_CMD_TX_DATA && left == 0 && chunk <= 256) {
+				uint32_t data[64];
+				rpm_rx_peek(data, 16, (chunk + 3u) & ~3u);
+				rpm_parse_reply((const uint8_t *)data, chunk);
+			}
+			break;
+		}
+		case GLINK_CMD_INTENT:
+			need = ALIGN8(8 + 8 * param2);
+			if (param2 > 64) {
+				return false;
+			}
+			if (avail < need) {
+				return true;
+			}
+			break;
+		case GLINK_CMD_READ_NOTIF:
+			rpm_rx_advance(8);
+			rpm_wr(rpm.ipc + 8, 1);
+			continue;
+		case GLINK_CMD_CLOSE_ACK:
+		case GLINK_CMD_RX_DONE:
+		case GLINK_CMD_RX_DONE_W_REUSE:
+		case GLINK_CMD_RX_INTENT_REQ:
+		case GLINK_CMD_RX_INTENT_REQ_ACK:
+		case GLINK_CMD_SIGNALS:
+			break;
+		default:
+			printf("SWEET RPM: unknown command %u (%#x %#x)\n", cmd, msg[0], msg[1]);
+			return false;
+		}
+		rpm_rx_advance(need);
+	}
+	return true;
+}
+
+/* Poll for up to ms milliseconds until *flag is set. */
+static bool
+rpm_wait(volatile bool *flag, unsigned ms)
+{
+	for (unsigned i = 0; i <= ms; ++i) {
+		if (!rpm_rx_poll()) {
+			rpm.broken = true;
+			return false;
+		}
+		if (*flag) {
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
+}
+
+static int
+rpm_map(void)
+{
+	if (rpm.mapped) {
+		return 0;
+	}
+	rpm.ram = ml_io_map(RPM_RAM_PA, RPM_RAM_SIZE);
+	rpm.ipc = ml_io_map(RPM_IPC_PA, 0x1000);
+	if (!rpm.ram || !rpm.ipc) {
+		return ENOMEM;
+	}
+	vm_offset_t toc = rpm.ram + RPM_RAM_SIZE - RPM_TOC_SIZE;
+	uint32_t magic = rpm_rd(toc), count = rpm_rd(toc + 4);
+	if (magic != RPM_TOC_MAGIC || count > (RPM_TOC_SIZE - 8) / 12) {
+		printf("SWEET RPM: bad TOC magic %#x count %u\n", magic, count);
+		return ENXIO;
+	}
+	for (uint32_t i = 0; i < count; ++i) {
+		vm_offset_t e = toc + 8 + 12 * i;
+		uint32_t id = rpm_rd(e), offset = rpm_rd(e + 4), size = rpm_rd(e + 8);
+		if (offset > RPM_RAM_SIZE || size > RPM_RAM_SIZE - offset || size < 64 || (size & 7u)) {
+			continue;
+		}
+		struct rpm_pipe *p = id == RPM_TX_FIFO_ID ? &rpm.tx : id == RPM_RX_FIFO_ID ? &rpm.rx : NULL;
+		if (p) {
+			p->tail = rpm.ram + offset;
+			p->head = rpm.ram + offset + 4;
+			p->fifo = rpm.ram + offset + 8;
+			p->len = size;
+		}
+	}
+	if (!rpm.tx.len || !rpm.rx.len || !rpm_pipe_ok(&rpm.tx) || !rpm_pipe_ok(&rpm.rx)) {
+		printf("SWEET RPM: FIFOs not found or invalid (tx %u rx %u)\n", rpm.tx.len, rpm.rx.len);
+		return ENXIO;
+	}
+	printf("SWEET RPM: TOC ok: tx %#x+%#x head %u tail %u, rx %#x+%#x head %u tail %u\n",
+	    (uint32_t)(rpm.tx.tail - rpm.ram), rpm.tx.len, rpm_rd(rpm.tx.head), rpm_rd(rpm.tx.tail),
+	    (uint32_t)(rpm.rx.tail - rpm.ram), rpm.rx.len, rpm_rd(rpm.rx.head), rpm_rd(rpm.rx.tail));
+	rpm.mapped = true;
+	return 0;
+}
+
+static int
+rpm_link_up(void)
+{
+	int error = rpm_map();
+	if (error) {
+		return error;
+	}
+	rpm.version_ack = rpm.open_ack = rpm.remote_open = false;
+	rpm.rcid = RPM_NO_RCID;
+	if (!rpm_rx_poll()) {
+		return EIO;
+	}
+	error = rpm_cmd(GLINK_CMD_VERSION, GLINK_VERSION_1, 0);
+	if (error) {
+		return error;
+	}
+	bool got_version = rpm_wait(&rpm.version_ack, 500);
+	struct {
+		uint32_t msg[2];
+		char name[16];
+	} open;
+	bzero(&open, sizeof(open));
+	open.msg[0] = GLINK_CMD_OPEN | (RPM_LCID << 16);
+	open.msg[1] = sizeof(RPM_CHANNEL);
+	strlcpy(open.name, RPM_CHANNEL, sizeof(open.name));
+	error = rpm_tx(&open, ALIGN8(8 + sizeof(RPM_CHANNEL)), NULL, 0);
+	if (error) {
+		return error;
+	}
+	bool acked = rpm_wait(&rpm.open_ack, 1000);
+	if (acked) {
+		(void)rpm_wait(&rpm.remote_open, 200);
+	}
+	printf("SWEET RPM: link version-ack=%d open-ack=%d remote-open=%d rcid=%d\n",
+	    got_version, acked, rpm.remote_open, (int)rpm.rcid);
+	if (!acked) {
+		return ETIMEDOUT;
+	}
+	rpm.up = true;
+	return 0;
+}
+
+static int
+rpm_request(uint32_t set, uint32_t type, uint32_t id, const uint32_t *kvp, uint32_t nkvp)
+{
+	struct {
+		uint32_t service, length;                       /* qcom_rpm_header */
+		uint32_t msg_id, flags, type, id, data_len;     /* qcom_rpm_request */
+		uint32_t kvp[9];
+	} pkt;
+	struct {
+		uint32_t msg[2];
+		uint32_t chunk_size, left_size;
+	} hdr;
+	if (nkvp > 3) {
+		return EINVAL;
+	}
+	uint32_t kvp_len = 12 * nkvp;
+	pkt.service = RPM_SERVICE_REQ;
+	pkt.length = 20 + kvp_len;
+	pkt.msg_id = ++rpm.msg_id;
+	pkt.flags = set;
+	pkt.type = type;
+	pkt.id = id;
+	pkt.data_len = kvp_len;
+	memcpy(pkt.kvp, kvp, kvp_len);
+	uint32_t size = 28 + kvp_len;
+	hdr.msg[0] = GLINK_CMD_TX_DATA | (RPM_LCID << 16);
+	hdr.msg[1] = 0;                 /* intentless: no intent id */
+	hdr.chunk_size = size;
+	hdr.left_size = 0;
+	rpm.replied = false;
+	int error = rpm_tx(&hdr, sizeof(hdr), &pkt, size);
+	if (error) {
+		return error;
+	}
+	for (unsigned i = 0; i < 4; ++i) {
+		if (!rpm_wait(&rpm.replied, 250)) {
+			return rpm.broken ? EIO : ETIMEDOUT;
+		}
+		if (rpm.reply_id == pkt.msg_id) {
+			return rpm.reply_status;
+		}
+		rpm.replied = false;            /* a stale reply: keep waiting */
+	}
+	return ETIMEDOUT;
+}
+
+/* Enable an RPM regulator ("ldoa", 28, 3300000 uV, 100 mA) in both sets. */
+int
+sweet_rpm_vreg_enable(const char *type, unsigned id, unsigned uv, unsigned ma)
+{
+	static bool tried;
+	if (!tried) {
+		tried = true;
+		rpm.lock = IOLockAlloc();
+	}
+	if (!rpm.lock || !type || strlen(type) != 4) {
+		return EINVAL;
+	}
+	uint32_t type_word = (uint32_t)(uint8_t)type[0] | (uint32_t)(uint8_t)type[1] << 8 |
+	    (uint32_t)(uint8_t)type[2] << 16 | (uint32_t)(uint8_t)type[3] << 24;
+	uint32_t kvp[9] = {
+		RPM_KEY_SWEN, 4, 1,
+		RPM_KEY_UV, 4, uv,
+		RPM_KEY_MA, 4, ma,
+	};
+	int error = 0;
+	IOLockLock(rpm.lock);
+	if (rpm.broken) {
+		error = EIO;
+	} else if (!rpm.up) {
+		error = rpm_link_up();
+	}
+	if (!error) {
+		error = rpm_request(RPM_SET_ACTIVE, type_word, id, kvp, ma ? 3 : 2);
+	}
+	if (!error) {
+		error = rpm_request(RPM_SET_SLEEP, type_word, id, kvp, ma ? 3 : 2);
+	}
+	IOLockUnlock(rpm.lock);
+	printf("SWEET RPM: %s%u on at %u uV, %u mA: %s (%d)\n", type, id, uv, ma,
+	    error ? "FAILED" : "ok", error);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
