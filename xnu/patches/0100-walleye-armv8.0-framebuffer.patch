diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..4d8e503 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,7 +515,7 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (0x9d400000 + 1888 * 4320)	// walleye: last 32 rows of 1080x1920
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..d042bf6 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,10 +11,13 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+/* walleye splash buffer, inside the 32MB block that start.s maps at 0x9c000000 */
+#define EARLY_FB_BLOCK_PA 0x9c000000u
+#define EARLY_FB_PA 0x9d400000u
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)EARLY_FB_PA;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
+#define EARLY_HEIGHT 1920u
 #define EARLY_STRIDE (4320u / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
@@ -129,7 +132,7 @@ void
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
-	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_fb = (volatile uint32_t *)(uintptr_t)(base + (EARLY_FB_PA - EARLY_FB_BLOCK_PA));
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..4133388 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -7,6 +7,10 @@
  * VMAPPLE. Unlike VMAPPLE the GIC has two security states (GICD_TYPER
  * SecurityExtn=1): Group 0 belongs to TrustZone, so every interrupt,
  * including the timer, is a Group 1 IRQ taken through sleh_irq().
+ *
+ * walleye (Pixel 2, MSM8998): Kryo 280 is ARMv8.0. No PAN, no LSE atomics
+ * (-march=armv8-a in MakeInc.def), and only the big cores (MPIDR 0x10n)
+ * have the 16K granule; the shim hands xnu one of those.
  */
 
 #ifndef _PEXPERT_ARM64_SWEET_H
@@ -33,7 +37,6 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
-#define __ARM_PAN_AVAILABLE__     1
 #define __ARM_16K_PG__            1
 
 #define HAS_GIC_V3                1
