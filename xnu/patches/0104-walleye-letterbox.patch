+/*
+ * Bilinear copy of a layer's logical rect (dx,dy,w,h; source at sx,sy)
+ * into the letterboxed panel area. Samples are clamped to the rect.
+ */
+static void
+sweet_fb_scaled_copy(AppleCLCD *fb, uintptr_t src, uint32_t bpr,
+    int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	int32_t px0 = fb->fOutX + (int32_t)(((int64_t)dx * fb->fScaleQ16) >> 16);
+	int32_t px1 = fb->fOutX + (int32_t)((((int64_t)(dx + w) * fb->fScaleQ16) + 0xffff) >> 16);
+	int32_t py0 = fb->fOutY + (int32_t)(((int64_t)dy * fb->fScaleQ16) >> 16);
+	int32_t py1 = fb->fOutY + (int32_t)((((int64_t)(dy + h) * fb->fScaleQ16) + 0xffff) >> 16);
+	if (px0 < fb->fOutX) {
+		px0 = fb->fOutX;
+	}
+	if (py0 < fb->fOutY) {
+		py0 = fb->fOutY;
+	}
+	if (px1 > fb->fOutX + (int32_t)fb->fOutW) {
+		px1 = fb->fOutX + (int32_t)fb->fOutW;
+	}
+	if (py1 > fb->fOutY + (int32_t)fb->fOutH) {
+		py1 = fb->fOutY + (int32_t)fb->fOutH;
+	}
+	if (px0 >= px1 || py0 >= py1) {
+		return;
+	}
+	/* Column table: source x (in the layer) and its 8-bit fraction. */
+	for (int32_t px = px0; px < px1; px++) {
+		int64_t lx = (((int64_t)(px - fb->fOutX) << 16) + 0x8000) * fb->fInvQ16 >> 16;	/* Q16 logical x */
+		lx -= ((int64_t)dx << 16) + 0x8000;
+		if (lx < 0) {
+			lx = 0;
+		}
+		int32_t x = (int32_t)(lx >> 16), f = (int32_t)((lx >> 8) & 0xff);
+		if (x >= w - 1) {
+			x = w - 1;
+			f = 0;
+		}
+		fb->fColX[px] = (uint32_t)(sx + x) << 8 | (uint32_t)f;
+	}
+	for (int32_t py = py0; py < py1; py++) {
+		int64_t ly = (((int64_t)(py - fb->fOutY) << 16) + 0x8000) * fb->fInvQ16 >> 16;
+		ly -= ((int64_t)dy << 16) + 0x8000;
+		if (ly < 0) {
+			ly = 0;
+		}
+		int32_t y = (int32_t)(ly >> 16);
+		uint32_t fy = (uint32_t)((ly >> 8) & 0xff);
+		if (y >= h - 1) {
+			y = h - 1;
+			fy = 0;
+		}
+		const uint32_t *r0 = (const uint32_t *)(src + (uint64_t)(sy + y) * bpr);
+		const uint32_t *r1 = fy ? (const uint32_t *)(src + (uint64_t)(sy + y + 1) * bpr) : r0;
+		uint32_t *out = (uint32_t *)(fb->fPixels + (uint64_t)py * fb->fRowBytes);
+		for (int32_t px = px0; px < px1; px++) {
+			uint32_t c = fb->fColX[px], x = c >> 8, fx = c & 0xff;
+			uint32_t x1 = fx ? x + 1 : x;
+			uint32_t top = sweet_lerp(r0[x], r0[x1], fx);
+			out[px] = fy ? sweet_lerp(top, sweet_lerp(r1[x], r1[x1], fx), fy) : top;
+		}
+	}
+}
